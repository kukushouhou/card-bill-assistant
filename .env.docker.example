# ===== Docker Compose 部署配置（复制为 .env 后修改，或用 scripts/gen-env 一键生成）=====
# 必填项缺失时容器无法启动
#
# 两种数据库模式（二选一）：
#   内置 MySQL：填 MYSQL_ROOT_PASSWORD / MYSQL_PASSWORD → docker compose pull && docker compose up -d
#   外置 MySQL：填 DATABASE_URL → docker compose -f docker-compose.external.yml pull && docker compose -f docker-compose.external.yml up -d

# 官方容器镜像版本。建议固定版本，不要在生产环境长期使用 latest
APP_VERSION=0.2.0

# ---------- 模式一：内置 MySQL（compose 自动创建 db 容器）----------
# MySQL root 密码
MYSQL_ROOT_PASSWORD=root_change_me
# MySQL 业务账号密码（提醒助手连接用）
MYSQL_PASSWORD=please_change_me

# ---------- 模式二：外置 MySQL（连接已存在的实例，需先创建空库）----------
# 连接串（密码含特殊字符需 URL 编码：! → %21  @ → %40  & → %26  # → %23）
# 应用启动时自动建表
# DATABASE_URL=mysql://user:password@192.168.1.10:3306/due_reminder?connection_limit=10

# ---------- 通用必填 ----------
# 【必填】环境主密钥：32 字节 hex（64 个字符），用于加密邮箱授权码、通知渠道配置 + 参与 PIN 双密钥派生
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 一经部署不可更改，否则已有密文全部失效！
ENCRYPTION_KEY=

# 【必填】JWT 签名密钥（随机长字符串）
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# 登录 Cookie 是否仅允许 HTTPS 传输。生产环境默认 true；仅局域网纯 HTTP 部署才设 false
COOKIE_SECURE=true

# ---------- 通用可选 ----------
# 应用显示名（登录页/导航栏/浏览器标题/测试通知），留空使用默认「守候信用卡小管家」
APP_NAME=

# 每日提醒推送时刻（小时，0-23，上海时区）
REMINDER_HOUR=8

# Bark 推送地址（可选；也可登录后在「系统设置」页配置）
# 形如 https://api.day.app/YourKey
BARK_URL=

# 宿主机绑定地址与对外端口。仅给同机反向代理使用时可将 APP_BIND_IP 改为 127.0.0.1
APP_BIND_IP=0.0.0.0
APP_PORT=3000
